{
  "permissions": {
    "allow": [
      "Bash(npx serve:*)",
      "Read(./**)"
    ],
    "deny": [
      "Bash(rm chat.txt)",
      "Bash(rm *WhatsApp*)",
      "Bash(rm *Resumo_Proposta*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/contagem-eleicao.mjs\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-originais.mjs\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verificar-conteudo.mjs\"" }
        ]
      }
    ]
  }
}
